# BIG MARGIN — environment configuration
# Data source selection: "demo" | "http"
VITE_DATA_PROVIDER=demo

# Base URL of the BIG MARGIN backend API (used when VITE_DATA_PROVIDER=http).
# The frontend never talks to vendor APIs directly and never holds vendor keys.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional: public site URL for SEO/OG tags
VITE_SITE_URL=https://bigmargin.app
