# =========================================================================
# BIG MARGIN — environment configuration
#
# SECURITY (§70): this file configures the FRONTEND only. Every VITE_ variable
# is compiled into the JavaScript bundle and is therefore public. No vendor
# API key, token, or secret may ever appear here. The frontend talks only to
# the BIG MARGIN backend; the backend holds the vendor credentials and is the
# only thing that talks to a market data vendor.
# =========================================================================

# ---------------------------- Equity market data -------------------------
# "demo" | "http"
#   demo — the labelled synthetic dataset. Every figure is generated, the app
#          shows a permanent demo banner, and no number describes a real market.
#   http — the BIG MARGIN backend, which fronts the real vendors below.
VITE_DATA_PROVIDER=demo

# Base URL of the BIG MARGIN backend API (used when VITE_DATA_PROVIDER=http).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional: public site URL for SEO / Open Graph tags.
VITE_SITE_URL=https://bigmargin.app


# ------------------------------- Options data ----------------------------
# "demo" | "http" | "off"
#   demo — generated contracts, clearly labelled as such in the UI.
#   http — the backend's options endpoints (see VITE_OPTIONS_API_BASE_URL).
#   off  — the Options section is hidden entirely: the nav entry disappears
#          and the stock-profile tab is not rendered. Use this rather than
#          shipping an empty chain when no options feed is licensed.
VITE_OPTIONS_PROVIDER=demo

# Optional: a separate base URL for options endpoints. Falls back to
# VITE_API_BASE_URL when unset, which is the normal single-backend setup.
# VITE_OPTIONS_API_BASE_URL=http://localhost:4000/api/v1


# =========================================================================
# BACKEND configuration — NOT read by the frontend.
#
# The variables below belong in the backend's own environment. They are
# documented here so the whole data contract lives in one place, and so it is
# obvious which values must never cross into a VITE_ variable.
# =========================================================================

# ------------------------- Saudi market (TASI) ---------------------------
# Decision: delayed Saudi data is acceptable for launch.
#
# Tadawul does not sell retail real-time feeds directly; delayed TASI data is
# resold by licensed distributors. Whichever distributor is chosen, confirm in
# writing before launch:
#
#   • the exact delay (commonly 15 minutes) — it is displayed on every quote
#     via the Provenance envelope, so it must be the contractual figure, not
#     an assumption;
#   • whether index constituent weights and free-float share counts are
#     included — BIG MARGIN computes TASI impact from free-float shares, so
#     without them the whole index-intelligence section reads "unavailable";
#   • whether redistribution to end users is permitted, and whether an
#     attribution string must be displayed (set SAUDI_ATTRIBUTION below).
#
# SAUDI_PROVIDER=
# SAUDI_API_KEY=
# SAUDI_DELAY_MINUTES=15
# SAUDI_ATTRIBUTION=

# ----------------------------- US market ---------------------------------
# Decision: run on a free tier until the app grows, then upgrade.
#
# Free US equity tiers are workable for this app because the screens are
# request-light: quotes are fetched per visible symbol and cached, not
# streamed. Before committing to one, confirm:
#
#   • the request ceiling per minute and per day — the backend must throttle
#     to it and return a 'delayed' or 'unavailable' status rather than an
#     error the UI cannot explain;
#   • whether the free tier is delayed and by how much (set US_DELAY_MINUTES
#     so the provenance badge tells the truth);
#   • whether a free tier permits displaying data to end users at all. Several
#     permit personal use only. This is the constraint that most often forces
#     an upgrade, not the rate limit.
#
# US_PROVIDER=
# US_API_KEY=
# US_DELAY_MINUTES=15
# US_ATTRIBUTION=

# ----------------------------- Options feed ------------------------------
# Listed options are a US product; Tadawul lists no retail single-stock
# options, so the app only offers this section on US instruments.
#
# Options feeds price separately from equities and most equity free tiers
# exclude them. When no chain is licensed, set VITE_OPTIONS_PROVIDER=off
# rather than shipping an empty section.
#
# If the feed omits Greeks or implied volatility — the common case on cheaper
# tiers — BIG MARGIN prices them itself with Black–Scholes–Merton from the mid
# quote and labels them 'calculated'. Vendor values are never overwritten.
# Set the model inputs the pricing uses:
#
# OPTIONS_PROVIDER=
# OPTIONS_API_KEY=
# OPTIONS_RISK_FREE_RATE=0.045

# ---------------------------- Shariah screening --------------------------
# Classifications are never computed by BIG MARGIN and never inferred. They
# are sourced from the screening authorities and shown with the authority's
# name, methodology, and publication date. Where authorities disagree, the app
# surfaces the disagreement rather than picking a winner.
#
# SHARIAH_SOURCES=
# SHARIAH_REFRESH_CRON=0 3 * * *
